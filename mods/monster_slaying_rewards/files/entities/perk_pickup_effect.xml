<!--
文件功能描述：
  天赋拾取时的视觉特效实体。包含粒子发射、生命周期控制与材料转换效果，用于强化拾取反馈。

主要模块说明：
  - `ParticleEmitterComponent`：发射红色火花粒子并控制渲染与生命周期。
  - `LifetimeComponent`：控制实体存在时长。
  - `MagicConvertMaterialComponent`：将指定材料在一定半径内转换为其他材料（此处为 glowstone→blood）。

修改历史记录：
  - 2025-12-11：添加规范中文注释；未更改任何字段值。

-->
<Entity>

    <!-- 粒子发射组件：用于拾取时的火花效果 -->
    <ParticleEmitterComponent
            emitted_material_name="spark_red"
            gravity.y="0.0"
            lifetime_min="8"
            lifetime_max="15"
            count_min="8"
            count_max="8"
            render_on_grid="1"
            fade_based_on_lifetime="1"
            area_circle_radius.min="0"
            area_circle_radius.max="0"
            cosmetic_force_create="0"
            airflow_force="0.251"
            airflow_time="1.01"
            airflow_scale="0.05"
            emission_interval_min_frames="1"
            emission_interval_max_frames="1"
            emit_cosmetic_particles="1"
            image_animation_file="data/particles/image_emitters/potion_effect.png"
            image_animation_raytrace_from_center="1"
            image_animation_speed="5"
            image_animation_loop="0"
            is_emitting="1" >
    </ParticleEmitterComponent>

    <!-- 生命周期组件：控制持续时间 -->
    <LifetimeComponent
            lifetime="260" >
    </LifetimeComponent>

    <!-- 材料转换组件：在范围内进行材料替换效果 -->
    <MagicConvertMaterialComponent
            _enabled="1"
            kill_when_finished="0"
            from_material="glowstone"
            steps_per_frame="5"
            to_material="blood"
            radius="128" >
    </MagicConvertMaterialComponent>


</Entity>

