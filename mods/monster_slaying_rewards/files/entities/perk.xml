<!--
文件功能描述：
  天赋图标精灵资源定义。用于在生成的天赋物品上显示对应 UI 图标。

主要模块说明：
  - `Sprite`：基础精灵资源，指定图片与偏移。
  - `RectAnimation`：矩形帧动画配置（此处为单帧）。

修改历史记录：
  - 2025-12-11：添加规范中文注释；未更改任何字段值。

-->
<Sprite
        filename="mods/monster_slaying_rewards/data/img/perk.png"
        offset_x="8"
        offset_y="8"
>

    <!-- 单帧动画配置：用于渲染静态图标 -->
    <RectAnimation
            name="default"
            pos_x="0"
            pos_y="0"
            frame_count="1"
            frame_width="16"
            frame_height="16"
            frame_wait="0.2"
            frames_per_row="10"
            loop="0"  >
    </RectAnimation>

</Sprite>
